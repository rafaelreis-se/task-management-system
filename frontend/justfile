# Frontend Commands
# For root commands, use: just <command> from project root
# For frontend-only: cd frontend && just <command>

# List commands
default:
    @just --list

# ═══════════════════════════════════════════════════════════
# 🚀 Development
# ═══════════════════════════════════════════════════════════

# Start development server
dev:
    @echo "🎨 Starting Vite dev server..."
    @npm run dev

# Build for production
build:
    @echo "🔨 Building for production..."
    @npm run build

# Preview production build
preview:
    @echo "👀 Previewing production build..."
    @npm run preview

# ═══════════════════════════════════════════════════════════
# 📦 Dependencies
# ═══════════════════════════════════════════════════════════

# Install dependencies
install:
    @echo "📦 Installing dependencies..."
    @npm install

# Update dependencies
update:
    @echo "🔄 Updating dependencies..."
    @npm update

# Clean node_modules and reinstall
reinstall:
    @echo "🧹 Cleaning and reinstalling..."
    @rm -rf node_modules package-lock.json
    @npm install

# ═══════════════════════════════════════════════════════════
# 🧹 Cleanup
# ═══════════════════════════════════════════════════════════

# Clean build artifacts
clean:
    @echo "🧹 Cleaning..."
    @rm -rf dist node_modules

# Clean only build
clean-build:
    @rm -rf dist

# ═══════════════════════════════════════════════════════════
# 🔍 Code Quality
# ═══════════════════════════════════════════════════════════

# Run ESLint
lint:
    @echo "🔍 Linting..."
    @npm run lint

# Fix ESLint issues
lint-fix:
    @echo "🔧 Fixing lint issues..."
    @npx eslint . --ext ts,tsx --fix

# Format code with Prettier
format:
    @echo "✨ Formatting code..."
    @npx prettier --write "src/**/*.{ts,tsx,json,css,md}"

# ═══════════════════════════════════════════════════════════
# 📊 Info
# ═══════════════════════════════════════════════════════════

# Show project info
info:
    @echo "╔══════════════════════════════════════════════════════════╗"
    @echo "║        Task Management System - Frontend                 ║"
    @echo "╠══════════════════════════════════════════════════════════╣"
    @echo "║ Framework:        React 18 + TypeScript                  ║"
    @echo "║ UI Library:       Material-UI (MUI)                      ║"
    @echo "║ Build Tool:       Vite                                   ║"
    @echo "║ HTTP Client:      Axios                                  ║"
    @echo "║ Forms:            React Hook Form                        ║"
    @echo "╚══════════════════════════════════════════════════════════╝"
    @echo ""
    @echo "💡 From project root, use: just dev"
    @echo ""

# Show URLs
urls:
    @echo "🌐 Application URLs:"
    @echo "   Frontend:  http://localhost:5173"
    @echo "   Backend:   http://localhost:5000"
    @echo ""
    @echo "👤 Demo credentials:"
    @echo "   Email:     john@example.com"
    @echo "   Password:  TestPassword123"
    @echo ""

