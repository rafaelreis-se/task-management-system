# Backend Commands
# For root commands, use: just <command> from project root
# For backend-only: cd backend && just <command>

# List commands
default:
    @just --list

# ═══════════════════════════════════════════════════════════
# 🚀 Development
# ═══════════════════════════════════════════════════════════

# Run API (with auto-reload)
run-watch:
    @echo "🚀 Starting API with hot reload..."
    @cd src/TaskManagement.API && dotnet watch run

# Run API (production mode)
run:
    @echo "🚀 Starting API..."
    @cd src/TaskManagement.API && dotnet run

# Build solution
build:
    @echo "🔨 Building backend..."
    @dotnet build

# Clean build artifacts
clean:
    @dotnet clean

# ═══════════════════════════════════════════════════════════
# 🧪 Testing
# ═══════════════════════════════════════════════════════════

# Run all tests
test:
    @dotnet test

# Run tests with coverage (terminal view)
test-coverage:
    @./show-coverage.sh

# Run tests with coverage (HTML report)
coverage-html:
    @echo "📊 Generating HTML coverage report..."
    @dotnet test --collect:"XPlat Code Coverage" --results-directory ./TestResults > /dev/null
    @reportgenerator -reports:"TestResults/**/coverage.cobertura.xml" \
        -targetdir:"TestResults/html" -reporttypes:Html
    @echo "✅ Report: TestResults/html/index.html"
    @open TestResults/html/index.html || true

# Watch tests (auto-run on changes)
test-watch:
    @dotnet watch test

# ═══════════════════════════════════════════════════════════
# 🗄️  Database
# ═══════════════════════════════════════════════════════════

# Start database
db-up:
    @echo "🐘 Starting PostgreSQL..."
    @docker-compose up -d postgres
    @echo "✅ Database started"

# Stop database
db-down:
    @echo "🛑 Stopping PostgreSQL..."
    @docker-compose down

# Run migrations
db-migrate:
    @echo "📋 Running migrations..."
    @docker exec -i gym-management-db psql -U postgres -d taskmanagement < src/TaskManagement.Infrastructure/Data/Scripts/001_create_tables.sql

# Seed test data
db-seed:
    @echo "🌱 Seeding database..."
    @docker exec -i gym-management-db psql -U postgres -d taskmanagement < src/TaskManagement.Infrastructure/Data/Scripts/002_seed_data.sql

# Setup database (migrate + seed)
db-setup: db-migrate db-seed
    @echo "✅ Database ready!"

# Connect to database CLI
db-connect:
    @docker exec -it gym-management-db psql -U postgres -d taskmanagement

# ═══════════════════════════════════════════════════════════
# 🔧 Setup
# ═══════════════════════════════════════════════════════════

# Complete setup (first time)
setup: db-up
    @echo "⏳ Waiting for database..."
    @sleep 3
    @just db-setup
    @echo "✅ Setup complete! Run 'just run-watch' to start"

# Start everything (db + api)
start: db-up
    @echo "⏳ Waiting for database..."
    @sleep 3
    @just run-watch

# ═══════════════════════════════════════════════════════════
# 🐳 Docker
# ═══════════════════════════════════════════════════════════

# Start all services with Docker
docker-up:
    @docker-compose up -d

# Rebuild and start
docker-rebuild:
    @docker-compose up -d --build

# View logs
docker-logs:
    @docker-compose logs -f

# Clean everything
docker-clean:
    @docker-compose down -v

# ═══════════════════════════════════════════════════════════
# 📊 Info
# ═══════════════════════════════════════════════════════════

# Show project info
info:
    @echo "╔══════════════════════════════════════════════════════════╗"
    @echo "║        Task Management System - Backend                  ║"
    @echo "╠══════════════════════════════════════════════════════════╣"
    @echo "║ .NET:             $(dotnet --version)"
    @echo "║ Architecture:     Clean Architecture                     ║"
    @echo "║ Testing:          TDD with xUnit                         ║"
    @echo "║ Database:         PostgreSQL                             ║"
    @echo "║ Data Access:      ADO.NET (No EF/Dapper)                ║"
    @echo "║ Auth:             JWT (manual)                           ║"
    @echo "╚══════════════════════════════════════════════════════════╝"
    @echo ""
    @echo "💡 From project root, use: just dev"
    @echo ""
